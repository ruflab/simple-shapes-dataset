{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Python: Debug Cell",
        "type": "python",
        "request": "launch",
        "justMyCode": false,
        "console": "integratedTerminal"
      },
      {
        "type": "python",
        "request": "launch",
        "name": "current file",
        "program": "${file}",
        "justMyCode": false,
        "env": {
            "DEBUG": "1",
            "CUDA_VISIBLE_DEVICES": "1",
            "CUDA_DEVICE_ORDER": "PCI_BUS_ID"
        }
      }
    ]
  }